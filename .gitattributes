# Auto detect text files and perform LF normalization
* text=auto

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text

# Source code
*.js text
*.jsx text
*.json text
*.css text
*.html text
*.yaml text
*.yml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
